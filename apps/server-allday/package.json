{
  "name": "server-allday-frontend",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "sync:logo": "node scripts/sync-brand-logo.cjs",
    "prestart": "npm run sync:logo",
    "preweb": "npm run sync:logo",
    "prebuild:web": "npm run sync:logo",
    "start": "expo start --web --port 3001",
    "web": "expo start --web --port 3001",
    "preview:web": "node scripts/preview.cjs",
    "web:fast": "npm run build:web && npm run preview:web",
    "build:web": "expo export --platform web",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "expo": "~54.0.0",
    "expo-clipboard": "~8.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.0",
    "nativewind": "^4.2.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-worklets": "0.5.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "babel-preset-expo": "~54.0.0",
    "tailwindcss": "^3.4.17"
  }
}
