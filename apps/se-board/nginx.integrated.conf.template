server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location = /allday { return 308 /allday/; }

    # This page belongs to SEBoard, not to the rental web bundle.
    location = /allday/sso {
        try_files /index.html =404;
        add_header Cache-Control "no-store";
        add_header Referrer-Policy "no-referrer";
    }
    location = /allday/sso/ { return 308 /allday/sso; }

    location = /api/v1/sso/callback {
        proxy_pass ${ALLDAY_API_UPSTREAM};
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_cache off;
        # Compatibility with the current backend's fixed root return URL.
        # Already-correct /allday/ redirects and other paths are left intact.
        proxy_redirect ~^https?://[^/]+/(\?sso=(?:expired|unavailable))?$ /allday/$1;
        proxy_redirect ~^/(\?sso=(?:expired|unavailable))?$ /allday/$1;
        access_log off;
        add_header Referrer-Policy "no-referrer" always;
        add_header Cache-Control "no-store" always;
    }
    location ^~ /api/v1/ {
        proxy_pass ${ALLDAY_API_UPSTREAM};
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_cache off;
        add_header Cache-Control "no-store" always;
    }
    location ^~ /api/internal/ { return 404; }

    location = /allday/index.html {
        try_files $uri =404;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }
    location ^~ /allday/_expo/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location ^~ /allday/assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location ^~ /allday/ {
        try_files $uri $uri/ /allday/index.html;
        add_header Cache-Control "no-cache";
    }

    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }
    location / { try_files $uri $uri/ /index.html; }
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;
    gzip_min_length 1024;
}
